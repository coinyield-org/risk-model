MATCH (a:RiskModelNode {uid: 'deployment:m0.ethereum'}), (b:RiskModelNode {uid: 'risk:attestation_vs_audit_gap'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:m0.ethereum:active_risk:attestation_vs_audit_gap'}]->(b)
SET r += {deployment: 'ethereum', note: 'M0 uses Certora formal verification specifications rather than traditional PDF audit reports; Certora specs verify mathematical properties of contract logic but do not cover operational risk, upgrade authority risk, or off-chain custody of minter collateral — the absence of traditional audit PDFs leaves a gap in the standard risk assessment framework', risk_id: 'attestation_vs_audit_gap', source_path: 'protocols/m0.md', uid: 'deployment:m0.ethereum:active_risk:attestation_vs_audit_gap'};

MATCH (a:RiskModelNode {uid: 'deployment:m0.ethereum'}), (b:RiskModelNode {uid: 'risk:governance_hostile_decision'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:m0.ethereum:active_risk:governance_hostile_decision'}]->(b)
SET r += {deployment: 'ethereum', note: 'M0 governance controls the minter and validator allowlists; a hostile governance action could approve malicious minters, remove honest validators, or alter the collateral eligibility criteria in ways that weaken the M backing standard — particularly relevant given the protocol\'s institutional-only participation model', risk_id: 'governance_hostile_decision', source_path: 'protocols/m0.md', uid: 'deployment:m0.ethereum:active_risk:governance_hostile_decision'};

MATCH (a:RiskModelNode {uid: 'deployment:m0.ethereum'}), (b:RiskModelNode {uid: 'risk:rwa_issuer_default'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:m0.ethereum:active_risk:rwa_issuer_default'}]->(b)
SET r += {deployment: 'ethereum', note: 'M0 minters are approved institutional counterparties who mint M tokens against off-chain Treasury collateral; if a minter becomes insolvent or fails to maintain adequate backing, the M tokens they issued become undercollateralized. The risk is distributed across the minter set but concentrated by minter, not pooled — a single large minter default could exceed the protocol\'s surplus buffer', risk_id: 'rwa_issuer_default', source_path: 'protocols/m0.md', uid: 'deployment:m0.ethereum:active_risk:rwa_issuer_default'};

MATCH (a:RiskModelNode {uid: 'deployment:m0.ethereum'}), (b:RiskModelNode {uid: 'risk:withdrawal_queue_delay'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:m0.ethereum:active_risk:withdrawal_queue_delay'}]->(b)
SET r += {deployment: 'ethereum', note: 'M redemption requires minters to liquidate or transfer Treasury holdings, which operate on T+1/T+2 settlement; during periods of Treasury market stress or minter operational delays, redemptions may be queued or deferred — M cannot be redeemed instantaneously on-chain', risk_id: 'withdrawal_queue_delay', source_path: 'protocols/m0.md', uid: 'deployment:m0.ethereum:active_risk:withdrawal_queue_delay'};

MATCH (a:RiskModelNode {uid: 'deployment:m0.ethereum'}), (b:RiskModelNode {uid: 'dependency:approved_minters'})
MERGE (a)-[r:DEPENDS_ON {uid: 'deployment:m0.ethereum:depends_on:approved_minters'}]->(b)
SET r += {dependency_id: 'approved_minters', dependency_type: 'issuer', note: 'M0 allows approved institutional minters to create M tokens against eligible collateral (US Treasuries); minter creditworthiness is assessed off-chain by the M0 governance process', scope: ['ethereum'], source_path: 'protocols/m0.md', uid: 'deployment:m0.ethereum:depends_on:approved_minters'};

