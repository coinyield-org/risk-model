MERGE (n:Incident:RiskModelNode {uid: 'incident:2024-09-03_penpie'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 27000000, chains: [], confidence: 'high', date: '2024-09-03', event_type: 'exploit', incident_id: 'incident:2024-09-03_penpie', near_miss: false, notes: 'OUT OF SCOPE. Root cause was a reentrancy bug in the _harvestBatchMarketRewards function, which lacked a reentrancy guard. The attacker registered a fake Pendle market (Penpie allowed permissionless market registration), then re-entered the harvest function during reward calculation to artificially inflate flash-loaned token balances and claim inflated rewards, draining $27M. This is a code-level reentrancy/access-control bug; the permissionless market registration was the enabling condition but the exploitable flaw is in the contract logic.', risk_ids: '[]', source_path: 'incidents/auto_2024-09-03_penpie.yaml', source_urls: '["https://x.com/shoucccc/status/1831044487323529639"]', title: 'Penpie', uid: 'incident:2024-09-03_penpie'};

