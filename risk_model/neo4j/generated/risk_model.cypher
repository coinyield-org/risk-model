SET r += {deployment: 'ethereum', note: 'Steakhouse and Grove (B.Protocol) curate the majority of USDC/USDT Morpho TVL; curator error (wrong LTV, wrong oracle, wrong asset whitelist) propagates to all depositors in their vaults without an additional governance layer to catch it', risk_id: 'concentrated_pool_dependency', source_path: 'protocols/morpho.md', uid: 'deployment:morpho.ethereum:active_risk:concentrated_pool_dependency'};

MATCH (a:RiskModelNode {uid: 'deployment:morpho.ethereum'}), (b:RiskModelNode {uid: 'risk:liquidation_bonus_too_small'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:morpho.ethereum:active_risk:liquidation_bonus_too_small'}]->(b)
SET r += {deployment: 'all_deployments', note: 'Each Morpho market has its own LLTV and liquidation incentive set by the curator at deployment; markets with aggressive LLTVs and thin liquidation bonuses may become unprofitable to liquidate during a volatile price gap', risk_id: 'liquidation_bonus_too_small', source_path: 'protocols/morpho.md', uid: 'deployment:morpho.ethereum:active_risk:liquidation_bonus_too_small'};

MATCH (a:RiskModelNode {uid: 'deployment:morpho.ethereum'}), (b:RiskModelNode {uid: 'risk:oracle_coverage_absence'})
