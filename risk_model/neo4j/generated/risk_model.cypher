MERGE (n:Incident:RiskModelNode {uid: 'incident:2025-06-25_resupply'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 9600000, chains: [], confidence: 'high', date: '2025-06-25', event_type: 'exploit', incident_id: 'incident:2025-06-25_resupply', near_miss: false, notes: 'Code/math bug — donation attack: attacker exploited a 2-hour-old crcrvUSD vault with near-zero liquidity. Donated 2,000 crvUSD to manipulate the share exchange rate to effectively 0, then deposited 1 wei of crcrvUSD to borrow ~$9.6M. Classic ERC-4626-style inflation/donation attack. OUT OF SCOPE — smart contract math/initialization bug, not a structural taxonomy risk. Sources: https://www.halborn.com/blog/post/explained-the-resupply-hack-june-2025 https://www.quillaudits.com/blog/hack-analysis/resupply-hack-analysis https://ackee.xyz/blog/resupply-hack-analysis/', risk_ids: '[]', source_path: 'incidents/auto_2025-06-25_resupply.yaml', source_urls: '["https://x.com/peckshield/status/1938061948647817647"]', title: 'Resupply', uid: 'incident:2025-06-25_resupply'};

