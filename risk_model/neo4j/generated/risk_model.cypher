MATCH (a:RiskModelNode {uid: 'protocol:portal_wormhole'}), (b:RiskModelNode {uid: 'risk:bridge_pause_censorship'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:portal_wormhole:active_risk:bridge_pause_censorship'}]->(b)
SET r += {deployment: 'all', note: 'Wormhole Foundation controls guardian set membership; removal or replacement of guardians can be executed unilaterally, effectively pausing the bridge for specific routes or globally', risk_id: 'bridge_pause_censorship', source_path: 'protocols/portal_wormhole.md', uid: 'protocol:portal_wormhole:active_risk:bridge_pause_censorship'};

MATCH (a:RiskModelNode {uid: 'protocol:portal_wormhole'}), (b:RiskModelNode {uid: 'risk:bridged_backing_loss'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:portal_wormhole:active_risk:bridged_backing_loss'}]->(b)
SET r += {deployment: 'all', note: 'Portal uses a lock-and-mint model; wrapped tokens on destination chains are claims on assets locked in source-chain vaults. An exploit on any supported chain\'s endpoint contract can drain locks without burning wrapped supply, destroying peg', risk_id: 'bridged_backing_loss', source_path: 'protocols/portal_wormhole.md', uid: 'protocol:portal_wormhole:active_risk:bridged_backing_loss'};

MATCH (a:RiskModelNode {uid: 'protocol:portal_wormhole'}), (b:RiskModelNode {uid: 'risk:guardian_key_leak'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:portal_wormhole:active_risk:guardian_key_leak'}]->(b)
SET r += {deployment: 'all', note: 'The 13/19 guardian threshold is the sole cryptographic security guarantee; compromise of 13 guardian keys (via social engineering, infrastructure breach, or insider) allows forging arbitrary VAAs — replicating the Feb 2022 exploit vector. Jump Crypto rescued that incident ($320M) but no equivalent backstop is guaranteed', risk_id: 'guardian_key_leak', source_path: 'protocols/portal_wormhole.md', uid: 'protocol:portal_wormhole:active_risk:guardian_key_leak'};

MATCH (a:RiskModelNode {uid: 'protocol:portal_wormhole'}), (b:RiskModelNode {uid: 'risk:per_deployment_divergence'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:portal_wormhole:active_risk:per_deployment_divergence'}]->(b)
SET r += {deployment: 'all', note: 'Each chain\'s endpoint contract is independently deployed and may have divergent upgrade schedules, guardian-set sync delays, and rate-limit configurations — creating windows where one chain\'s state is inconsistent with others', risk_id: 'per_deployment_divergence', source_path: 'protocols/portal_wormhole.md', uid: 'protocol:portal_wormhole:active_risk:per_deployment_divergence'};

MATCH (a:RiskModelNode {uid: 'protocol:portal_wormhole'}), (b:RiskModelNode {uid: 'risk:proxy_upgrade_authority'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:portal_wormhole:active_risk:proxy_upgrade_authority'}]->(b)
SET r += {deployment: 'all', note: 'Core Bridge contracts on each chain are upgradeable proxies; upgrade authority is held by Wormhole Foundation multisigs with varying timelock configurations per chain', risk_id: 'proxy_upgrade_authority', source_path: 'protocols/portal_wormhole.md', uid: 'protocol:portal_wormhole:active_risk:proxy_upgrade_authority'};

