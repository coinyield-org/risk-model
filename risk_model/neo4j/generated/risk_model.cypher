MERGE (n:Incident:RiskModelNode {uid: 'incident:2026-04-01_drift_trade'})
SET n += {affected_assets: [], affected_protocols: ['drift'], amount_lost_usd: 285000000, chains: [], confidence: 'high', date: '2026-04-01', event_type: 'governance', incident_id: 'incident:2026-04-01_drift_trade', near_miss: false, notes: 'North Korean actors (UNC4736/Citrine Sleet) spent six months infiltrating Drift under the guise of a quant trading firm, compromising developer devices via a malicious app and IDE vulnerability to obtain Security Council multisig signatures on pre-signed durable-nonce transactions (governance_signer_key_leak). Those pre-signed transactions transferred admin control instantly with zero timelock (flash_governance). The attackers then whitelisted a worthless fabricated token (CVT) as collateral and withdrew $285M in real assets — the fake-collateral whitelisting maps to hostile_proposal_via_delegation as governance was used to push through malicious parameter changes.', risk_ids: '["governance_signer_key_leak", "flash_governance", "hostile_proposal_via_delegation"]', source_path: 'incidents/auto_2026-04-01_drift_trade.yaml', source_urls: '["https://x.com/driftprotocol/status/2038782521002795133"]', title: 'Drift Trade', uid: 'incident:2026-04-01_drift_trade'};

