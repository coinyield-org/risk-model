MATCH (a:RiskModelNode {uid: 'protocol:cap'}), (b:RiskModelNode {uid: 'risk:deployer_key_leak'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:cap:active_risk:deployer_key_leak'}]->(b)
SET r += {deployment: 'all', note: 'No public audits have been identified for cap; contract upgrade authority and admin keys held by an unverified team represent the primary unquantified risk — a malicious or compromised upgrade could bypass collateral requirements or drain reserves', risk_id: 'deployer_key_leak', source_path: 'protocols/cap.md', uid: 'protocol:cap:active_risk:deployer_key_leak'};

MATCH (a:RiskModelNode {uid: 'protocol:cap'}), (b:RiskModelNode {uid: 'risk:governance_hostile_decision'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:cap:active_risk:governance_hostile_decision'}]->(b)
SET r += {deployment: 'all', note: 'cap has no identified governance process; all collateral listings, LTV parameters, and interest rate configurations are set unilaterally by the team. Aggressive parameter choices — or parameter changes that benefit insiders at depositor expense — cannot be contested on-chain', risk_id: 'governance_hostile_decision', source_path: 'protocols/cap.md', uid: 'protocol:cap:active_risk:governance_hostile_decision'};

MATCH (a:RiskModelNode {uid: 'protocol:cap'}), (b:RiskModelNode {uid: 'risk:liquidation_bonus_too_small'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:cap:active_risk:liquidation_bonus_too_small'}]->(b)
SET r += {deployment: 'all', note: 'As a new protocol with untested collateral risk parameters, liquidation bonus calibration has not been stress-tested in live market conditions; an inadequately sized bonus reduces liquidator incentive during volatility, allowing undercollateralized positions to accumulate bad debt', risk_id: 'liquidation_bonus_too_small', source_path: 'protocols/cap.md', uid: 'protocol:cap:active_risk:liquidation_bonus_too_small'};

MATCH (a:RiskModelNode {uid: 'protocol:cap'}), (b:RiskModelNode {uid: 'risk:oracle_staleness'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:cap:active_risk:oracle_staleness'}]->(b)
SET r += {deployment: 'all', note: 'As a new lending protocol with no public documentation, the oracle configuration — provider, heartbeat, deviation threshold, and fallback mechanism — has not been independently verified; incorrect oracle setup is the most common source of lending protocol exploit losses', risk_id: 'oracle_staleness', source_path: 'protocols/cap.md', uid: 'protocol:cap:active_risk:oracle_staleness'};

