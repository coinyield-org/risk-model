MERGE (n:Incident:RiskModelNode {uid: 'incident:2024-07-31_terra_2_0'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 5000000, chains: [], confidence: 'high', date: '2024-07-31', event_type: 'exploit', incident_id: 'incident:2024-07-31_terra_2_0', near_miss: false, notes: 'Code bug — reentrancy vulnerability in the IBC hooks timeout callback. A patch was applied in April 2024 but accidentally reverted in a June update. Attacker used an IBC call + timeout sequence to mint tokens that had been IBC-transferred onto Terra, stealing ~$5M (60M ASTRO, 3.5M USDC, 500K USDT, 2.7 BTC). Chain briefly halted; operations resumed after patching. OUT OF SCOPE — smart contract reentrancy bug. Sources: https://www.theblock.co/post/308440/attacker-exploits-ibc-hooks-vulnerability-to-steal-tokens-on-terra-blockchain https://x.com/terra_money/status/1818648481266888950 https://decrypt.co/242549/terra-blockchain-exploit-drains-over-4-million-in-tokens', risk_ids: '[]', source_path: 'incidents/auto_2024-07-31_terra_2_0.yaml', source_urls: '["https://x.com/terra_money/status/1818648481266888950"]', title: 'Terra 2.0', uid: 'incident:2024-07-31_terra_2_0'};

