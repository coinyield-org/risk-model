SET n += {affected_assets: ['JELLY'], affected_protocols: ['hyperliquid_hlp', 'hyperliquid'], amount_lost_usd: 12000000, chains: ['hyperliquid_l1'], confidence: 'high', date: '2025-03-26', event_type: 'bad_debt', incident_id: 'incident:2025-03-26_hyperliquid_jelly_incident', near_miss: false, notes: 'A trader opened a $430M long position on the illiquid JELLY token on Hyperliquid, then intentionally triggered their own liquidation; Hyperliquid\'s HLP vault was forced as the counterparty of last resort, accumulating a large losing position. The Hyperliquid core team intervened by delisting JELLY and setting an artificial settlement price, socializing ~$12M in losses and raising concerns about centralized governance override of market mechanics.', risk_ids: '["bad_debt_socialization", "whale_concentration", "governance_hostile_decision", "insurance_fund_depletion"]', source_path: 'incidents/2025-03-26_hyperliquid_jelly_incident.yaml', source_urls: '["https://thedefiant.io/hyperliquid-jelly-token-delisted-after-market-manipulation", "https://rekt.news/hyperliquid-jelly-rekt/"]', title: 'Hyperliquid JELLY HLP Bad Debt Incident', uid: 'incident:2025-03-26_hyperliquid_jelly_incident'};

