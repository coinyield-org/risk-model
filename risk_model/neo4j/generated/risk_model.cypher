MERGE (n:Incident:RiskModelNode {uid: 'incident:2022-02-02_wormhole_bridge_exploit'})
SET n += {affected_assets: ['wETH'], affected_protocols: ['portal_wormhole'], amount_lost_usd: 320000000, chains: ['ethereum', 'solana'], confidence: 'high', date: '2022-02-02', event_type: 'bridge', incident_id: 'incident:2022-02-02_wormhole_bridge_exploit', near_miss: false, notes: 'Attacker exploited a flaw in Wormhole\'s guardian signature verification contract on Solana, allowing them to spoof a valid guardian set and mint 120,000 wETH on Solana without locking any ETH on Ethereum. This directly broke the bridge\'s 1:1 backing guarantee; Jump Crypto subsequently recapitalized the bridge to cover the $320M shortfall.', risk_ids: '["bridge_dep", "bridge_signing_committee", "bridge_lock_backing_loss", "unauthorized_mint"]', source_path: 'incidents/2022-02-02_wormhole_bridge_exploit.yaml', source_urls: '["https://wormholecrypto.medium.com/wormhole-incident-report-02-02-22-ad9b8f21eec6", "https://rekt.news/wormhole-rekt/"]', title: 'Wormhole Bridge Guardian Signature Bypass', uid: 'incident:2022-02-02_wormhole_bridge_exploit'};

