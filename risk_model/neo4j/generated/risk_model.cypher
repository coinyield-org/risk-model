MERGE (n:Incident:RiskModelNode {uid: 'incident:2024-01-01_eigenlayer_lst_restaking_cliff'})
SET n += {affected_assets: ['rsETH', 'ezETH', 'weETH'], affected_protocols: ['eigenlayer', 'kelp', 'renzo', 'etherfi'], amount_lost_usd: 0, chains: ['ethereum'], confidence: 'medium', date: '2024-01-01', event_type: 'liquidation', incident_id: 'incident:2024-01-01_eigenlayer_lst_restaking_cliff', near_miss: true, notes: 'Billions of dollars in LSTs were deposited into EigenLayer and liquid restaking protocols to farm points with no real AVS slashing conditions active; when AVS go live and slashing becomes enforceable, depositors face sudden activation of tail-risk slashing on capital that was treated as risk-free parking. This is a systemic near-miss: the risk has not yet materialized but the structural conditions for a large slashing cascade are in place.', risk_ids: '["restaking_protocol_dep", "validator_slashing_erosion", "validator_avs_slashing", "withdrawal_queue_delay"]', source_path: 'incidents/2024-01-01_eigenlayer_lst_restaking_cliff.yaml', source_urls: '["https://eigenlayer.mirror.xyz/jCLmCsgkFtRSe3bwgkMwM4LhIpCJZsz5dVXezXnKWi8", "https://blockworks.co/news/eigenlayer-risks-avs-slashing"]', title: 'EigenLayer LST Restaking TVL Cliff Risk (Ongoing)', uid: 'incident:2024-01-01_eigenlayer_lst_restaking_cliff'};

MERGE (n:Incident:RiskModelNode {uid: 'incident:2024-01-01_orbit_bridge_exploit'})
SET n += {affected_assets: ['USDC', 'WBTC', 'ETH', 'USDT'], affected_protocols: [], amount_lost_usd: 82000000, chains: ['ethereum'], confidence: 'high', date: '2024-01-01', event_type: 'bridge', incident_id: 'incident:2024-01-01_orbit_bridge_exploit', near_miss: false, notes: 'Attackers compromised multiple private keys of Orbit Bridge\'s multi-signature signing committee, enabling them to authorize fraudulent withdrawal transactions totaling ~$82M across USDC, WBTC, ETH, and USDT. The exploit occurred on New Year\'s Eve/Day and was not detected until the next morning; the exact key-compromise vector (suspected insider or phishing) was never publicly confirmed.', risk_ids: '["bridge_dep", "bridge_signing_committee", "governance_signer_key_leak"]', source_path: 'incidents/2024-01-01_orbit_bridge_exploit.yaml', source_urls: '["https://rekt.news/orbit-bridge-rekt/", "https://medium.com/orbit-chain/orbit-bridge-exploit-december-31-2023-january-1-2024-b06d77e79238"]', title: 'Orbit Bridge Private Key Compromise', uid: 'incident:2024-01-01_orbit_bridge_exploit'};

