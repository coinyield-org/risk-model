MATCH (a:RiskModelNode {uid: 'protocol:bouncebit'}), (b:RiskModelNode {uid: 'risk:chain_halt'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:bouncebit:active_risk:chain_halt'}]->(b)
SET r += {deployment: 'all', note: 'BounceBit operates on a proprietary PoS chain with a permissioned validator set; a consensus failure, validator coordination failure, or infrastructure outage halts withdrawals and on-chain settlements with no fallback to a decentralized chain', risk_id: 'chain_halt', source_path: 'protocols/bouncebit.md', uid: 'protocol:bouncebit:active_risk:chain_halt'};

MATCH (a:RiskModelNode {uid: 'protocol:bouncebit'}), (b:RiskModelNode {uid: 'risk:custodian_risk'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:bouncebit:active_risk:custodian_risk'}]->(b)
SET r += {deployment: 'all', note: 'Mainnet Digital custodian holds 100% of the BTC/USDT backing the BounceBit yield strategy off-chain; insolvency, regulatory seizure, or misappropriation at Mainnet Digital results in direct loss with no on-chain recourse — analogous to the Celsius/BlockFi custody risk pattern', risk_id: 'custodian_risk', source_path: 'protocols/bouncebit.md', uid: 'protocol:bouncebit:active_risk:custodian_risk'};

MATCH (a:RiskModelNode {uid: 'protocol:bouncebit'}), (b:RiskModelNode {uid: 'risk:issuer_corporate_risk'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:bouncebit:active_risk:issuer_corporate_risk'}]->(b)
SET r += {deployment: 'all', note: 'The BounceBit Foundation controls the proprietary chain, smart contracts, and yield distribution mechanics; regulatory action against the foundation, key personnel departure, or business failure would halt operations with limited recourse for depositors', risk_id: 'issuer_corporate_risk', source_path: 'protocols/bouncebit.md', uid: 'protocol:bouncebit:active_risk:issuer_corporate_risk'};

MATCH (a:RiskModelNode {uid: 'protocol:bouncebit'}), (b:RiskModelNode {uid: 'risk:oracle_staleness'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:bouncebit:active_risk:oracle_staleness'}]->(b)
SET r += {deployment: 'all', note: 'Yield accrual and NAV calculation depend on off-chain funding rate data from CEX APIs; stale or manipulated feed data could misrepresent strategy performance and delay accurate depositor P&L accounting', risk_id: 'oracle_staleness', source_path: 'protocols/bouncebit.md', uid: 'protocol:bouncebit:active_risk:oracle_staleness'};

MATCH (a:RiskModelNode {uid: 'protocol:bouncebit'}), (b:RiskModelNode {uid: 'risk:perp_funding_feedback'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:bouncebit:active_risk:perp_funding_feedback'}]->(b)
SET r += {deployment: 'all', note: 'BounceBit yield depends on persistent positive perpetual funding rates on Binance/OKX; when market sentiment shifts and funding rates turn negative for extended periods, the strategy generates losses rather than yield, creating adverse P&L for depositors', risk_id: 'perp_funding_feedback', source_path: 'protocols/bouncebit.md', uid: 'protocol:bouncebit:active_risk:perp_funding_feedback'};

