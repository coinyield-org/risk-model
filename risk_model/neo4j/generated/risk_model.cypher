SET r += {deployment: 'hyperliquid_l1', note: 'When large leveraged positions generate losses exceeding the insurance fund, bad debt is socialized across HLP vault participants; this occurred during the March 2024 $JELLY incident where a whale\'s position forced significant mark-to-market losses on HLP depositors', risk_id: 'bad_debt_socialization', source_path: 'protocols/hyperliquid_hlp.md', uid: 'deployment:hyperliquid_hlp.hyperliquid_l1:active_risk:bad_debt_socialization'};

MATCH (a:RiskModelNode {uid: 'deployment:hyperliquid_hlp.hyperliquid_l1'}), (b:RiskModelNode {uid: 'risk:oracle_staleness'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:hyperliquid_hlp.hyperliquid_l1:active_risk:oracle_staleness'}]->(b)
SET r += {deployment: 'hyperliquid_l1', note: 'The Hyperliquid oracle price feed is produced by the Hyperliquid validator set — the same entities that validate blocks. This is not an independent oracle; validator collusion or a consensus failure can produce stale or manipulated prices that directly impact perp liquidation thresholds and HLP P&L', risk_id: 'oracle_staleness', source_path: 'protocols/hyperliquid_hlp.md', uid: 'deployment:hyperliquid_hlp.hyperliquid_l1:active_risk:oracle_staleness'};

MATCH (a:RiskModelNode {uid: 'deployment:hyperliquid_hlp.hyperliquid_l1'}), (b:RiskModelNode {uid: 'risk:perp_funding_feedback'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:hyperliquid_hlp.hyperliquid_l1:active_risk:perp_funding_feedback'}]->(b)
SET r += {deployment: 'hyperliquid_l1', note: 'HLP is the structural counterparty to all Hyperliquid perp trades; when aggregate trader positioning is net long, HLP is net short, and vice versa. Sustained one-sided market imbalance (e.g., large long bias during a bull run) creates directional P&L risk for the vault that cannot be hedged away within the platform', risk_id: 'perp_funding_feedback', source_path: 'protocols/hyperliquid_hlp.md', uid: 'deployment:hyperliquid_hlp.hyperliquid_l1:active_risk:perp_funding_feedback'};

MATCH (a:RiskModelNode {uid: 'deployment:hyperliquid_hlp.hyperliquid_l1'}), (b:RiskModelNode {uid: 'risk:whale_concentration'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:hyperliquid_hlp.hyperliquid_l1:active_risk:whale_concentration'}]->(b)
SET r += {deployment: 'hyperliquid_l1', note: 'Large traders can open positions sized to move against HLP\'s structural short/long exposure, exploiting the vault\'s known directional bias at period-end or during low-liquidity windows; the March 2024 JELLY incident demonstrated this attack vector explicitly', risk_id: 'whale_concentration', source_path: 'protocols/hyperliquid_hlp.md', uid: 'deployment:hyperliquid_hlp.hyperliquid_l1:active_risk:whale_concentration'};

