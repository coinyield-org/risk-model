SET n += {affected_assets: [], affected_protocols: ['kelp'], amount_lost_usd: 293000000, chains: [], confidence: 'high', date: '2026-04-18', event_type: 'bridge', incident_id: 'incident:2026-04-18_kelp', near_miss: false, notes: 'Attackers (attributed to Lazarus Group) compromised two RPC nodes serving Kelp\'s LayerZero integration and used a DDoS-forced failover to poison the verifier\'s data feed, forging a cross-chain message that minted 116,500 rsETH. The attack succeeded because Kelp ran a 1-of-1 verifier configuration (bridge_signing_committee) rather than the multi-verifier setup LayerZero recommended — a single compromised RPC was sufficient to authorize a fraudulent message (bridge_dep). Compromising the RPC/oracle nodes that feed the bridge verifier maps to oracle_operator_key_leak in the taxonomy.', risk_ids: '["bridge_dep", "bridge_signing_committee", "oracle_operator_key_leak"]', source_path: 'incidents/auto_2026-04-18_kelp.yaml', source_urls: '["https://x.com/BitcoinNews/status/2045583576578617749"]', title: 'Kelp', uid: 'incident:2026-04-18_kelp'};

