MERGE (n:Incident:RiskModelNode {uid: 'incident:2022-05-09_terra_ust_collapse'})
SET n += {affected_assets: ['UST', 'LUNA'], affected_protocols: [], amount_lost_usd: 40000000000, chains: [], confidence: 'high', date: '2022-05-09', event_type: 'depeg', incident_id: 'incident:2022-05-09_terra_ust_collapse', near_miss: false, notes: 'Coordinated large-scale redemptions of UST overwhelmed the LUNA mint/burn arbitrage mechanism, triggering a death spiral where UST depeg drove LUNA hyperinflation, which further eroded confidence in UST backing. The $40B collapse caused severe contagion to Celsius, Three Arrows Capital, and multiple lending protocols that held LUNA/UST as collateral.', risk_ids: '["soft_peg_algo_failure", "death_spiral", "depeg_feedback_loop", "contagion_bank_run", "self_fulfilling_depeg"]', source_path: 'incidents/2022-05-09_terra_ust_collapse.yaml', source_urls: '["https://www.nansen.ai/research/on-chain-forensics-demystifying-terrausd-depeg", "https://cryptobriefing.com/terra-luna-death-spiral-how-ust-lost-its-dollar-peg/"]', title: 'Terra / UST Algorithmic Stablecoin Collapse', uid: 'incident:2022-05-09_terra_ust_collapse'};

