MATCH (a:RiskModelNode {uid: 'protocol:centrifuge'}), (b:RiskModelNode {uid: 'risk:attestation_vs_audit_gap'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:centrifuge:active_risk:attestation_vs_audit_gap'}]->(b)
SET r += {deployment: 'all', note: 'NAV of each pool is computed by the asset originator based on their internal loan book valuations. There is no continuous on-chain proof of individual loan performance; lenders rely on periodic originator-provided reports.', risk_id: 'attestation_vs_audit_gap', source_path: 'protocols/centrifuge.md', uid: 'protocol:centrifuge:active_risk:attestation_vs_audit_gap'};

MATCH (a:RiskModelNode {uid: 'protocol:centrifuge'}), (b:RiskModelNode {uid: 'risk:fiat_ramp_gating'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:centrifuge:active_risk:fiat_ramp_gating'}]->(b)
SET r += {deployment: 'all', note: 'Capital flows into and out of Centrifuge pools require fiat wire transfers and KYC processes. On-chain secondary market liquidity for pool tokens (DROP/TIN) is thin; practical exit requires waiting for underlying loan repayments.', risk_id: 'fiat_ramp_gating', source_path: 'protocols/centrifuge.md', uid: 'protocol:centrifuge:active_risk:fiat_ramp_gating'};

MATCH (a:RiskModelNode {uid: 'protocol:centrifuge'}), (b:RiskModelNode {uid: 'risk:oracle_coverage_absence'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:centrifuge:active_risk:oracle_coverage_absence'}]->(b)
SET r += {deployment: 'all', note: 'Individual loan NAV pricing is subjective and originator-reported. There is no independent on-chain oracle providing real-time loan valuations. This creates information asymmetry between originators and passive liquidity providers.', risk_id: 'oracle_coverage_absence', source_path: 'protocols/centrifuge.md', uid: 'protocol:centrifuge:active_risk:oracle_coverage_absence'};

MATCH (a:RiskModelNode {uid: 'protocol:centrifuge'}), (b:RiskModelNode {uid: 'risk:rwa_business_hours'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:centrifuge:active_risk:rwa_business_hours'}]->(b)
SET r += {deployment: 'all', note: 'Pool redemptions are subject to lock-up periods defined per pool (often 30-90 days). Investors cannot exit on-demand; liquidity is gated by the loan repayment schedule of the underlying real-world borrowers.', risk_id: 'rwa_business_hours', source_path: 'protocols/centrifuge.md', uid: 'protocol:centrifuge:active_risk:rwa_business_hours'};

MATCH (a:RiskModelNode {uid: 'protocol:centrifuge'}), (b:RiskModelNode {uid: 'risk:rwa_counterparty_default'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:centrifuge:active_risk:rwa_counterparty_default'}]->(b)
SET r += {deployment: 'all', note: 'Real-world borrowers within each structured credit pool can default on their underlying loans. Unlike crypto-native collateral, recovery is subject to jurisdiction-specific insolvency law and SPV liquidation timelines, which can take months to years.', risk_id: 'rwa_counterparty_default', source_path: 'protocols/centrifuge.md', uid: 'protocol:centrifuge:active_risk:rwa_counterparty_default'};

MATCH (a:RiskModelNode {uid: 'protocol:centrifuge'}), (b:RiskModelNode {uid: 'risk:rwa_issuer_default'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:centrifuge:active_risk:rwa_issuer_default'}]->(b)
SET r += {deployment: 'all', note: 'Each asset originator is an independent credit risk. Originator insolvency (business failure, fraud, or legal issues) would impair the pool they manage. Historical incidents include BlockTower credit pool underperformance and New Silver pool restructuring.', risk_id: 'rwa_issuer_default', source_path: 'protocols/centrifuge.md', uid: 'protocol:centrifuge:active_risk:rwa_issuer_default'};

