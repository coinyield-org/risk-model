MERGE (n:Incident:RiskModelNode {uid: 'incident:2025-07-09_gmx_v1_perps'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 42000000, chains: [], confidence: 'high', date: '2025-07-09', event_type: 'exploit', incident_id: 'incident:2025-07-09_gmx_v1_perps', near_miss: false, notes: 'OUT OF SCOPE. Root cause was a cross-contract reentrancy bug in executeDecreaseOrder(): the function incorrectly assumed the _account parameter was an EOA, allowing a malicious contract to hijack control flow during ETH refunds and exploit a stale getAum() calculation to repeatedly mint GLP at a deflated price, extracting $42M from the GLP vault. This is a code-level reentrancy/logic error with no structural/systemic risk mapping in the taxonomy.', risk_ids: '[]', source_path: 'incidents/auto_2025-07-09_gmx_v1_perps.yaml', source_urls: '["https://x.com/peckshield/status/1942947860645134450"]', title: 'GMX V1 Perps', uid: 'incident:2025-07-09_gmx_v1_perps'};

