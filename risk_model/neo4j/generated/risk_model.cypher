MERGE (n:Incident:RiskModelNode {uid: 'incident:2025-05-22_cetus_clmm'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 223000000, chains: [], confidence: 'high', date: '2025-05-22', event_type: 'exploit', incident_id: 'incident:2025-05-22_cetus_clmm', near_miss: false, notes: 'OUT OF SCOPE. Root cause was a pure smart-contract math bug: an incorrect overflow guard in the checked_shlw function of the integer-mate shared math library allowed a silent integer overflow in the u256 fixed-point add-liquidity calculation, letting an attacker mint outsized liquidity credit for a single-token deposit and drain pool reserves. This is a code-level arithmetic precision error with no structural/systemic risk mapping in the taxonomy.', risk_ids: '[]', source_path: 'incidents/auto_2025-05-22_cetus_clmm.yaml', source_urls: '["https://www.coindesk.com/markets/2025/05/22/sui-networks-cetus-protocol-hit-in-apparent-hack-sending-token-prices-down-90"]', title: 'Cetus CLMM', uid: 'incident:2025-05-22_cetus_clmm'};

