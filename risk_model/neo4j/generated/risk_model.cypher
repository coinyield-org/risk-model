MERGE (n:Incident:RiskModelNode {uid: 'incident:2024-05-15_sonne_finance'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 20000000, chains: [], confidence: 'medium', date: '2024-05-15', event_type: 'exploit', incident_id: 'incident:2024-05-15_sonne_finance', near_miss: false, notes: 'Sonne deployed a new VELO market via a two-day timelock on Optimism, splitting market creation and c-factor configuration into separate permissionless transactions. The window between those timelocked steps left the newly-created market in a state exploitable by the known Compound v2 donation attack: an attacker front-ran the second transaction to inflate exchange rates via a direct VELO donation and drained $20M (governance_timelock_vs_attack_speed). The donation attack itself exploits the discrete state transition at market initialisation — a one-time precision-loss cliff — which maps to maturity_cliff_exploit as a structural temporal vulnerability in Compound v2 fork deployment procedures.', risk_ids: '["governance_timelock_vs_attack_speed", "maturity_cliff_exploit"]', source_path: 'incidents/auto_2024-05-15_sonne_finance.yaml', source_urls: '["https://medium.com/@SonneFinance/post-mortem-sonne-finance-exploit-12f3daa82b06"]', title: 'Sonne Finance', uid: 'incident:2024-05-15_sonne_finance'};

MERGE (n:Incident:RiskModelNode {uid: 'incident:2024-05-16_alex'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 4300000, chains: [], confidence: 'high', date: '2024-05-16', event_type: 'exploit', incident_id: 'incident:2024-05-16_alex', near_miss: false, notes: 'Deployer private key compromised via phishing attack. Attacker used the key to push 5 malicious upgrades to the XLink Bridge Endpoint contract (BNB chain), draining ~$4.3M in BTC, USDC, and SKO. Later linked to Lazarus Group. Root cause: deployer key leak. Sources: https://rekt.news/alexlab-rekt https://www.coindesk.com/business/2024/05/15/bitcoin-defi-tool-alex-lab-loses-43m-in-hack-offers-10-bounty-for-stolen-funds https://decrypt.co/news-explorer?pinned=595939&title=alex-lab-lost-43-million-in-tokens-after-a-suspected-private-key-compromise', risk_ids: '["deployer_key_leak"]', source_path: 'incidents/auto_2024-05-16_alex.yaml', source_urls: '["https://rekt.news/alexlab-rekt/"]', title: 'ALEX', uid: 'incident:2024-05-16_alex'};

