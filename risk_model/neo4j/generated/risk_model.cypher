MATCH (a:RiskModelNode {uid: 'protocol:unirouter'}), (b:RiskModelNode {uid: 'risk:bridge_lock_backing_loss'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:unirouter:active_risk:bridge_lock_backing_loss'}]->(b)
SET r += {deployment: 'all', note: 'UniRouter operates as a bridge with locked assets on source chains; the absence of any public documentation or audits means the lock-and-mint mechanism, reserve custody, and bridge signing authority are entirely unverified — backing loss via exploit or misappropriation cannot be ruled out', risk_id: 'bridge_lock_backing_loss', source_path: 'protocols/unirouter.md', uid: 'protocol:unirouter:active_risk:bridge_lock_backing_loss'};

MATCH (a:RiskModelNode {uid: 'protocol:unirouter'}), (b:RiskModelNode {uid: 'risk:deployer_key_leak'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:unirouter:active_risk:deployer_key_leak'}]->(b)
SET r += {deployment: 'all', note: 'No audits and no public smart contract documentation have been identified for UniRouter; upgrade authority and bridge operator keys are held by unknown parties, creating an unquantified but material key compromise risk', risk_id: 'deployer_key_leak', source_path: 'protocols/unirouter.md', uid: 'protocol:unirouter:active_risk:deployer_key_leak'};

MATCH (a:RiskModelNode {uid: 'protocol:unirouter'}), (b:RiskModelNode {uid: 'risk:oracle_staleness'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:unirouter:active_risk:oracle_staleness'}]->(b)
SET r += {deployment: 'all', note: 'No public information exists about UniRouter\'s price feed or asset valuation methodology; without a documented oracle, accurate pricing of bridged assets and detection of backing divergence is impossible for external observers', risk_id: 'oracle_staleness', source_path: 'protocols/unirouter.md', uid: 'protocol:unirouter:active_risk:oracle_staleness'};

