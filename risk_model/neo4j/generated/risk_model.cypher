MERGE (n:Incident:RiskModelNode {uid: 'incident:2022-04-17_beanstalk_flash_governance'})
SET n += {affected_assets: ['BEAN', 'USDC', 'ETH'], affected_protocols: [], amount_lost_usd: 182000000, chains: ['ethereum'], confidence: 'high', date: '2022-04-17', event_type: 'governance', incident_id: 'incident:2022-04-17_beanstalk_flash_governance', near_miss: false, notes: 'Attacker used a flash loan to borrow enough governance tokens (Stalk) to achieve a supermajority in a single block, then executed a pre-staged malicious proposal that drained the protocol treasury in the same transaction. Beanstalk\'s governance used spot token balances with no time-lock or time-weighted averaging, making it trivially vulnerable to flash-loan-powered hostile takeover.', risk_ids: '["flash_governance", "hostile_proposal_via_delegation", "governance_timelock_vs_attack_speed"]', source_path: 'incidents/2022-04-17_beanstalk_flash_governance.yaml', source_urls: '["https://rekt.news/beanstalk-rekt/", "https://bean.money/blog/beanstalk-governance-exploit"]', title: 'Beanstalk Farms Flash Loan Governance Attack', uid: 'incident:2022-04-17_beanstalk_flash_governance'};

