MATCH (a:RiskModelNode {uid: 'protocol:curve'}), (b:RiskModelNode {uid: 'risk:amplification_misconfig'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:curve:active_risk:amplification_misconfig'}]->(b)
SET r += {deployment: 'all', note: 'Curve pool operators can ramp the amplification coefficient (A parameter) over time. Rapid A parameter changes alter pool invariant and can be front-run to extract value from LPs during the transition window.', risk_id: 'amplification_misconfig', source_path: 'protocols/curve.md', uid: 'protocol:curve:active_risk:amplification_misconfig'};

MATCH (a:RiskModelNode {uid: 'protocol:curve'}), (b:RiskModelNode {uid: 'risk:governance_hostile_decision'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:curve:active_risk:governance_hostile_decision'}]->(b)
SET r += {deployment: 'all', note: 'Convex Finance holds approximately 50% of all veCRV, giving it a near-controlling vote in Curve governance. A compromised or hostile Convex governance action (e.g., via Convex\'s own multisig) can unilaterally redirect gauge emissions and influence pool parameter changes.', risk_id: 'governance_hostile_decision', source_path: 'protocols/curve.md', uid: 'protocol:curve:active_risk:governance_hostile_decision'};

MATCH (a:RiskModelNode {uid: 'protocol:curve'}), (b:RiskModelNode {uid: 'risk:thin_liquidity_source_manipulation'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:curve:active_risk:thin_liquidity_source_manipulation'}]->(b)
SET r += {deployment: 'all', note: 'Many DeFi protocols use Curve pools as on-chain price oracles (TWAP or spot). Pools with relatively thin liquidity can be manipulated by large flash-loan-funded swaps, propagating incorrect prices to oracle consumers built on top of Curve.', risk_id: 'thin_liquidity_source_manipulation', source_path: 'protocols/curve.md', uid: 'protocol:curve:active_risk:thin_liquidity_source_manipulation'};

MATCH (a:RiskModelNode {uid: 'protocol:curve'}), (b:RiskModelNode {uid: 'risk:whale_concentration'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:curve:active_risk:whale_concentration'}]->(b)
SET r += {deployment: 'all', note: 'veCRV is heavily concentrated. Beyond Convex (~50%), a handful of protocols and wallets control the majority of remaining veCRV. Low retail turnout in gauge votes means a small coalition can capture gauge emissions.', risk_id: 'whale_concentration', source_path: 'protocols/curve.md', uid: 'protocol:curve:active_risk:whale_concentration'};

