MERGE (n:Incident:RiskModelNode {uid: 'incident:2023-03-13_euler_bad_debt_socialization'})
SET n += {affected_assets: ['USDC', 'WSTETH', 'WBTC'], affected_protocols: [], amount_lost_usd: 197000000, chains: ['ethereum'], confidence: 'high', date: '2023-03-13', event_type: 'bad_debt', incident_id: 'incident:2023-03-13_euler_bad_debt_socialization', near_miss: false, notes: 'Smart contract exploit is out of scope. In scope: the resulting $197M bad debt socialization event and bank run on Euler liquidity pools — when the exploit was discovered, all supplier pools became undercollateralized simultaneously, triggering a mass withdrawal run that caused realized losses to be socialized across remaining liquidity providers before the attacker eventually returned most funds.', risk_ids: '["bad_debt_socialization", "undercollateralization_via_bad_debt", "utilization_full_bank_run"]', source_path: 'incidents/2023-03-13_euler_bad_debt_socialization.yaml', source_urls: '["https://euler.finance/blog/euler-attack", "https://rekt.news/euler-rekt/"]', title: 'Euler Finance Bad Debt Socialization', uid: 'incident:2023-03-13_euler_bad_debt_socialization'};

MERGE (n:Incident:RiskModelNode {uid: 'incident:2023-03-13_euler_v1'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 197000000, chains: [], confidence: 'high', date: '2023-03-13', event_type: 'exploit', incident_id: 'incident:2023-03-13_euler_v1', near_miss: false, notes: 'OUT OF SCOPE. Root cause was a smart-contract logic bug in the donateToReserves() function: it burned the user\'s eToken collateral without performing a health check, enabling an attacker to use a flash loan to enter a self-liquidatable position, donate collateral to reserves to push their position into bad health, then profit from the discrepancy between eToken and dToken values during liquidation. The vulnerability is a missing invariant check in contract code — not a structural/systemic oracle, governance, or market risk covered by this taxonomy.', risk_ids: '[]', source_path: 'incidents/auto_2023-03-13_euler_v1.yaml', source_urls: '["https://twitter.com/peckshield/status/1635229594596036608"]', title: 'Euler V1', uid: 'incident:2023-03-13_euler_v1'};

