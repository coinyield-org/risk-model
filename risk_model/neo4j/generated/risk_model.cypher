MERGE (n:Incident:RiskModelNode {uid: 'incident:2024-05-20_gala'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 22000000, chains: ['ethereum'], confidence: 'high', date: '2024-05-20', event_type: 'exploit', incident_id: 'incident:2024-05-20_gala', near_miss: false, notes: 'Gala Games: compromised admin key allowed minting 600M GALA tokens to the attacker address. Attacker immediately dumped on the market. Team burned equivalent tokens and partially recovered. ~$22M impact. Minter-authority / admin-key single point.', risk_ids: '["minter_authority", "governance_signer_key_leak"]', source_path: 'incidents/auto_2024-05-20_gala.yaml', source_urls: '["https://x.com/Thatguysgems/status/1792679865164128743"]', title: 'Gala', uid: 'incident:2024-05-20_gala'};

MERGE (n:Incident:RiskModelNode {uid: 'incident:2024-06-02_velocore_v2'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 6800000, chains: [], confidence: 'high', date: '2024-06-02', event_type: 'exploit', incident_id: 'incident:2024-06-02_velocore_v2', near_miss: false, notes: 'Code bug — fee calculation overflow in Balancer-style CPMM velocore__execute(). effectiveFee1e9 could exceed 100%, causing an underflow in single-token withdrawal math that minted an abnormally large amount of LP tokens. Also lacked caller verification on velocore__execute(). Attacker used flash loan to escalate feeMultiplier then exploited underflow to drain ~$6.8M ETH across Linea and zkSync Era. OUT OF SCOPE — smart contract math/logic bug. Sources: https://velocorexyz.medium.com/velocore-incident-post-mortem-6197020ec3e9 https://immunebytes.com/blog/velocore-finance-exploit-june-2-2024-detailed-analysis/', risk_ids: '[]', source_path: 'incidents/auto_2024-06-02_velocore_v2.yaml', source_urls: '["https://x.com/velocorexyz/status/1797229772399067587"]', title: 'Velocore V2', uid: 'incident:2024-06-02_velocore_v2'};

MERGE (n:Incident:RiskModelNode {uid: 'incident:2024-06-09_loopring'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 5000000, chains: [], confidence: 'high', date: '2024-06-09', event_type: 'exploit', incident_id: 'incident:2024-06-09_loopring', near_miss: false, notes: 'Loopring\'s Official Guardian (2FA/social-recovery) service was compromised. The attacker defeated 2FA, impersonated wallet owners, and initiated social recovery on wallets that had only the Official Guardian set (single-guardian wallets). ~$5M drained from 58 affected wallets out of 40K+ deployed. Root cause: guardian key / 2FA service compromise → guardian_key_leak. Sources: https://www.theblock.co/post/299177/loopring-suffers-5-million-hack-after-guardian-two-factor-authentication-service-is-compromised https://medium.com/loopring-protocol/postmortem-incident-report-and-path-forward-aa64f7e5f7d1 https://www.halborn.com/blog/post/explained-the-loopring-hack-june-2024', risk_ids: '["guardian_key_leak"]', source_path: 'incidents/auto_2024-06-09_loopring.yaml', source_urls: '["https://x.com/loopringorg/status/1799791898296451515"]', title: 'Loopring', uid: 'incident:2024-06-09_loopring'};

