SET r += {deployment: 'base', note: 'Base operates with Coinbase-specific configuration diverging from Optimism mainnet: different guardian thresholds, separate Security Council composition, and Coinbase-negotiated fee parameters — risk analysts must treat it as a distinct deployment, not a vanilla OP Stack instance', risk_id: 'per_deployment_profile_divergence', source_path: 'protocols/coinbase_bridge.md', uid: 'deployment:coinbase_bridge.base:active_risk:per_deployment_profile_divergence'};

