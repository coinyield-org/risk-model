MERGE (n:Incident:RiskModelNode {uid: 'incident:2024-10-18_radiant_multisig_compromise'})
SET n += {affected_assets: ['USDC', 'WBNB', 'ETH'], affected_protocols: [], amount_lost_usd: 55000000, chains: ['bnb', 'arbitrum'], confidence: 'high', date: '2024-10-18', event_type: 'exploit', incident_id: 'incident:2024-10-18_radiant_multisig_compromise', near_miss: false, notes: 'Malware on the devices of three Radiant Capital multisig signers intercepted and replaced legitimate transaction signatures, allowing the attacker to satisfy the 3-of-11 threshold and push malicious smart contract upgrades across both BSC and Arbitrum deployments. The attacker then drained $55M through the upgraded contracts, demonstrating that proxy upgrade authority combined with compromised endpoint security can bypass multisig threshold guarantees.', risk_ids: '["governance_signer_key_leak", "proxy_upgrade_authority", "deployer_key_leak"]', source_path: 'incidents/2024-10-18_radiant_multisig_compromise.yaml', source_urls: '["https://rekt.news/radiant-capital-rekt2/", "https://medium.com/@RadiantCapital/radiant-post-mortem-october-18-2024-feaf8095a0c5"]', title: 'Radiant Capital Multisig Hardware Wallet Compromise', uid: 'incident:2024-10-18_radiant_multisig_compromise'};

