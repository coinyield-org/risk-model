MATCH (a:RiskModelNode {uid: 'protocol:uniswap_v3'}), (b:RiskModelNode {uid: 'risk:governance_hostile_decision'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:uniswap_v3:active_risk:governance_hostile_decision'}]->(b)
SET r += {deployment: 'all', note: 'UNI governance controls the fee switch across all deployments; activation and fee-destination decisions are subject to UNI concentration risk and delegate politics, which have historically been slow and occasionally captured by large holders', risk_id: 'governance_hostile_decision', source_path: 'protocols/uniswap_v3.md', uid: 'protocol:uniswap_v3:active_risk:governance_hostile_decision'};

MATCH (a:RiskModelNode {uid: 'protocol:uniswap_v3'}), (b:RiskModelNode {uid: 'risk:liquidation_sandwich'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:uniswap_v3:active_risk:liquidation_sandwich'}]->(b)
SET r += {deployment: 'all', note: 'JIT (Just-In-Time) liquidity attacks: MEV bots add concentrated liquidity at the exact tick of a large swap in the same block, capture fees, then immediately remove — diluting organic LP returns without adding real depth. This is structurally enabled by V3\'s per-block LP management', risk_id: 'liquidation_sandwich', source_path: 'protocols/uniswap_v3.md', uid: 'protocol:uniswap_v3:active_risk:liquidation_sandwich'};

MATCH (a:RiskModelNode {uid: 'protocol:uniswap_v3'}), (b:RiskModelNode {uid: 'risk:twap_window_misconfig'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:uniswap_v3:active_risk:twap_window_misconfig'}]->(b)
SET r += {deployment: 'all', note: 'Uniswap V3 TWAP security is entirely a function of the observation window chosen by consumers. A narrow window (e.g. 5 min) is manipulable via flash-loan-funded spot moves; a wide window (e.g. 24h) is stale during fast markets. Uniswap itself does not enforce a window — risk is fully externalized', risk_id: 'twap_window_misconfig', source_path: 'protocols/uniswap_v3.md', uid: 'protocol:uniswap_v3:active_risk:twap_window_misconfig'};

