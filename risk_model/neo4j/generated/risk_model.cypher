MERGE (n:Incident:RiskModelNode {uid: 'incident:2022-01-28_qubit'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 80000000, chains: [], confidence: 'high', date: '2022-01-28', event_type: 'bridge', incident_id: 'incident:2022-01-28_qubit', near_miss: false, notes: 'OUT OF SCOPE. Root cause was a smart-contract logic bug: a legacy deposit() function was left in the QBridge contract after being superseded by depositETH(). The legacy function used a modified safeTransferFrom() that called the zero address, which has no code — the call returned success without any ETH transfer, yet the same on-chain event was emitted, causing the BSC-side relayer to mint qXETH for zero collateral. This is a dead-code / logic error in the smart contract, not a structural bridge or governance risk.', risk_ids: '[]', source_path: 'incidents/auto_2022-01-28_qubit.yaml', source_urls: '["https://medium.com/@QubitFin/protocol-exploit-report-305c34540fa3"]', title: 'Qubit', uid: 'incident:2022-01-28_qubit'};

MERGE (n:Incident:RiskModelNode {uid: 'incident:2022-02-01_bns'})
