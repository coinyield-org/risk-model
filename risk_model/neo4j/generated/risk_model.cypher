MERGE (n:Incident:RiskModelNode {uid: 'incident:2022-06-12_steth_celsius_depeg'})
SET n += {affected_assets: ['stETH', 'wstETH'], affected_protocols: ['lido', 'curve'], amount_lost_usd: 0, chains: ['ethereum'], confidence: 'high', date: '2022-06-12', event_type: 'depeg', incident_id: 'incident:2022-06-12_steth_celsius_depeg', near_miss: true, notes: 'Celsius, the largest stETH holder, faced a liquidity crisis and was forced to sell stETH on secondary markets. Because Lido withdrawals were not yet available (pre-Shanghai upgrade), the only exit was the Curve stETH/ETH pool, which became severely imbalanced; stETH traded as low as 0.94 ETH. The peg eventually recovered after Ethereum\'s Shanghai upgrade enabled withdrawals.', risk_ids: '["exchange_rate_vs_market_depeg", "withdrawal_queue_delay", "utilization_full_bank_run", "self_fulfilling_depeg", "concentrated_pool_dependency"]', source_path: 'incidents/2022-06-12_steth_celsius_depeg.yaml', source_urls: '["https://blockworks.co/news/how-the-steth-depeg-affects-the-whole-market", "https://thedefiant.io/celsius-steth-depeg-crisis"]', title: 'stETH Secondary Market Depeg — Celsius Crisis', uid: 'incident:2022-06-12_steth_celsius_depeg'};

