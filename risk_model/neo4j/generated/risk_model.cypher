SET n += {affected_assets: ['USDC', 'DAI'], affected_protocols: ['curve', 'aave_v3', 'compound_v3', 'sparklend'], amount_lost_usd: 0, chains: ['ethereum', 'arbitrum', 'polygon', 'optimism', 'base'], confidence: 'high', date: '2023-03-10', event_type: 'depeg', incident_id: 'incident:2023-03-10_usdc_svb_depeg', near_miss: true, notes: 'Circle disclosed $3.3B of USDC reserves held at Silicon Valley Bank when the FDIC seized the institution; with redemptions suspended over the weekend, USDC depegged to $0.87 on secondary markets. The depeg propagated across DeFi via Curve 3pool imbalance and MakerDAO PSM drain; the peg fully recovered after the US government guaranteed all SVB deposits on Monday.', risk_ids: '["stablecoin_depeg", "offchain_custodian_risk", "reserve_concentration", "self_fulfilling_depeg", "contagion_bank_run"]', source_path: 'incidents/2023-03-10_usdc_svb_depeg.yaml', source_urls: '["https://www.circle.com/blog/an-update-on-usdc-and-silicon-valley-bank", "https://thedefiant.io/usdc-depeg-svb-crisis"]', title: 'USDC Depeg — Silicon Valley Bank Closure', uid: 'incident:2023-03-10_usdc_svb_depeg'};

