MATCH (a:RiskModelNode {uid: 'protocol:buzz_farming'}), (b:RiskModelNode {uid: 'risk:deployer_key_leak'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:buzz_farming:active_risk:deployer_key_leak'}]->(b)
SET r += {deployment: 'all', note: 'No audits and no public smart contract documentation have been identified; admin and upgrade keys are held by an unknown team, creating full exposure to rug pull or malicious upgrade — funds could be redirected without warning', risk_id: 'deployer_key_leak', source_path: 'protocols/buzz_farming.md', uid: 'protocol:buzz_farming:active_risk:deployer_key_leak'};

MATCH (a:RiskModelNode {uid: 'protocol:buzz_farming'}), (b:RiskModelNode {uid: 'risk:governance_hostile_decision'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:buzz_farming:active_risk:governance_hostile_decision'}]->(b)
SET r += {deployment: 'all', note: 'Absence of on-chain governance means all parameter decisions — emission rates, vault allocations, fee structures — are made unilaterally by the team; there is no mechanism for depositors to contest or reverse adverse decisions', risk_id: 'governance_hostile_decision', source_path: 'protocols/buzz_farming.md', uid: 'protocol:buzz_farming:active_risk:governance_hostile_decision'};

MATCH (a:RiskModelNode {uid: 'protocol:buzz_farming'}), (b:RiskModelNode {uid: 'risk:incentive_end_liquidity_flight'})
