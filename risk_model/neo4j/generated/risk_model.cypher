MATCH (a:RiskModelNode {uid: 'protocol:ondo'}), (b:RiskModelNode {uid: 'risk:custodian_risk'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:ondo:active_risk:custodian_risk'}]->(b)
SET r += {deployment: 'all', note: 'USDY assets are custodied at HSBC; OUSG shares are held via Morgan Stanley. Custodian failure or asset freeze (e.g., sanctions) would impair redemption.', risk_id: 'custodian_risk', source_path: 'protocols/ondo.md', uid: 'protocol:ondo:active_risk:custodian_risk'};

MATCH (a:RiskModelNode {uid: 'protocol:ondo'}), (b:RiskModelNode {uid: 'risk:issuer_blacklist_function'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:ondo:active_risk:issuer_blacklist_function'}]->(b)
SET r += {deployment: 'all', note: 'Ondo contract admin retains the ability to freeze individual addresses on OUSG and USDY. Admin key compromise or coercion enables targeted asset freeze.', risk_id: 'issuer_blacklist_function', source_path: 'protocols/ondo.md', uid: 'protocol:ondo:active_risk:issuer_blacklist_function'};

MATCH (a:RiskModelNode {uid: 'protocol:ondo'}), (b:RiskModelNode {uid: 'risk:oracle_staleness'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:ondo:active_risk:oracle_staleness'}]->(b)
SET r += {deployment: 'all', note: 'Daily NAV updates mean the on-chain price of OUSG can be up to 24 hours stale. Protocols that accept OUSG as collateral may use an outdated valuation during a rapid rate spike.', risk_id: 'oracle_staleness', source_path: 'protocols/ondo.md', uid: 'protocol:ondo:active_risk:oracle_staleness'};

MATCH (a:RiskModelNode {uid: 'protocol:ondo'}), (b:RiskModelNode {uid: 'risk:rwa_business_hours'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'protocol:ondo:active_risk:rwa_business_hours'}]->(b)
SET r += {deployment: 'all', note: 'Redemptions require T+1 or T+2 wire settlement during US business hours. Weekend and holiday market dislocations cannot be arbitraged via on-chain mechanisms until next business day.', risk_id: 'rwa_business_hours', source_path: 'protocols/ondo.md', uid: 'protocol:ondo:active_risk:rwa_business_hours'};

MATCH (a:RiskModelNode {uid: 'protocol:ondo'}), (b:RiskModelNode {uid: 'risk:rwa_issuer_default'})
