MATCH (a:RiskModelNode {uid: 'deployment:stacks_sbtc.bitcoin'}), (b:RiskModelNode {uid: 'risk:chain_halt'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:stacks_sbtc.bitcoin:active_risk:chain_halt'}]->(b)
SET r += {deployment: 'bitcoin', note: 'Stacks L2 has a limited operational track record and a smaller validator/stacker set than mature L2s; a consensus failure or PoX mechanism breakdown halts sBTC minting, burning, and transfers, trapping BTC in the locked wallet with no settlement path until the chain recovers', risk_id: 'chain_halt', source_path: 'protocols/stacks_sbtc.md', uid: 'deployment:stacks_sbtc.bitcoin:active_risk:chain_halt'};

MATCH (a:RiskModelNode {uid: 'deployment:stacks_sbtc.bitcoin'}), (b:RiskModelNode {uid: 'risk:deployer_key_leak'})
