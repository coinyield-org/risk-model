MERGE (n:Incident:RiskModelNode {uid: 'incident:2023-03-17_paraspace_lending_v1'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 5000000, chains: [], confidence: 'medium', date: '2023-03-17', event_type: 'exploit', incident_id: 'incident:2023-03-17_paraspace_lending_v1', near_miss: false, notes: 'ParaSpace\'s fallback price oracle relied on Uniswap spot prices, vulnerable to flashloan manipulation. Attacker manipulated the staked value in the ApeCoinStaking contract to inflate cApe (elastic token) collateral size, then overborrowed. BlockSec Phalcon system intervened and rescued ~$5M; attack was ultimately thwarted. Root cause: fallback oracle using manipulable spot price (Uniswap pool) → fallback_oracle_misconfig. Sources: https://blocksec.com/blog/paraspace-incident-a-race-against-time-to-thwart-the-industrys-most-critical-attack-yet https://www.certik.com/ko/blog/aping-peril-the-price-manipulation-exploit-with-paraspace https://twitter.com/BlockSecTeam/status/1636650252844294144', risk_ids: '["fallback_oracle_misconfig"]', source_path: 'incidents/auto_2023-03-17_paraspace_lending_v1.yaml', source_urls: '["https://twitter.com/BlockSecTeam/status/1636650252844294144"]', title: 'ParaSpace Lending V1', uid: 'incident:2023-03-17_paraspace_lending_v1'};

