MERGE (n:Incident:RiskModelNode {uid: 'incident:2022-11-06_pando_rings'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 22000000, chains: [], confidence: 'high', date: '2022-11-06', event_type: 'exploit', incident_id: 'incident:2022-11-06_pando_rings', near_miss: false, notes: 'Attacker manipulated the price of the sBTC-WBTC LP token on 4swap (the Mixin-native DEX), which Pando Rings used as its price oracle source. The pool had thin liquidity, making the spot price easy to move. ~$22M drained; ~$50M frozen by Mixin Network. Root cause: thin-liquidity LP token used as oracle source → thin_liquidity_source_manipulation. Sources: https://pando.im/news/2022/2022-11-06-alert-to-pando-community-hack-of-pando-rings/ https://immunebytes.com/blog/pando-rings-hack-nov-5-2022-detailed-analysis/', risk_ids: '["thin_liquidity_source_manipulation"]', source_path: 'incidents/auto_2022-11-06_pando_rings.yaml', source_urls: '["https://pando.im/news/2022/2022-11-06-alert-to-pando-community-hack-of-pando-rings/"]', title: 'Pando Rings', uid: 'incident:2022-11-06_pando_rings'};

