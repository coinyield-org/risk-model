MATCH (a:RiskModelNode {uid: 'deployment:multipli.ethereum'}), (b:RiskModelNode {uid: 'risk:deep_chain_yield_trading'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:multipli.ethereum:active_risk:deep_chain_yield_trading'}]->(b)
SET r += {deployment: 'ethereum', note: 'Multipli stacks points farming on top of LRT positions, which themselves sit on EigenLayer restaking, which sits on Ethereum staking — creating a 4+ layer dependency chain where each layer carries independent smart contract, slashing, and liquidity risk; a failure at any layer propagates upward to Multipli depositors', risk_id: 'deep_chain_yield_trading', source_path: 'protocols/multipli.md', uid: 'deployment:multipli.ethereum:active_risk:deep_chain_yield_trading'};

MATCH (a:RiskModelNode {uid: 'deployment:multipli.ethereum'}), (b:RiskModelNode {uid: 'risk:deployer_key_leak'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:multipli.ethereum:active_risk:deployer_key_leak'}]->(b)
SET r += {deployment: 'ethereum', note: 'No public audits have been identified for Multipli smart contracts; the absence of an audit means that contract upgrade authority or admin keys represent an unquantified risk — a compromised or malicious upgrade could redirect depositor funds', risk_id: 'deployer_key_leak', source_path: 'protocols/multipli.md', uid: 'deployment:multipli.ethereum:active_risk:deployer_key_leak'};

MATCH (a:RiskModelNode {uid: 'deployment:multipli.ethereum'}), (b:RiskModelNode {uid: 'risk:incentive_end_liquidity_flight'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:multipli.ethereum:active_risk:incentive_end_liquidity_flight'}]->(b)
SET r += {deployment: 'ethereum', note: 'Multipli TVL is primarily driven by LRT points and airdrop expectations from EigenLayer and LRT protocol campaigns; once points campaigns conclude and airdrops are distributed, mercenary capital is likely to exit, leaving remaining depositors with illiquid or unexited positions', risk_id: 'incentive_end_liquidity_flight', source_path: 'protocols/multipli.md', uid: 'deployment:multipli.ethereum:active_risk:incentive_end_liquidity_flight'};

MATCH (a:RiskModelNode {uid: 'deployment:multipli.ethereum'}), (b:RiskModelNode {uid: 'risk:oracle_staleness'})
MERGE (a)-[r:HAS_ACTIVE_RISK {uid: 'deployment:multipli.ethereum:active_risk:oracle_staleness'}]->(b)
SET r += {deployment: 'ethereum', note: 'Points and yield accrual in multi-layer LRT strategies depend on off-chain tracking of restaking points, which has no on-chain oracle; mismatch between advertised and realized yield can only be detected after distribution events', risk_id: 'oracle_staleness', source_path: 'protocols/multipli.md', uid: 'deployment:multipli.ethereum:active_risk:oracle_staleness'};

