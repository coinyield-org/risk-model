MERGE (n:Incident:RiskModelNode {uid: 'incident:2022-09-08_ronin'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 12000000, chains: [], confidence: 'high', date: '2022-09-08', event_type: 'exploit', incident_id: 'incident:2022-09-08_ronin', near_miss: false, notes: 'NOTE: The $12M Ronin bridge incident that matches this amount actually occurred in August 2024, not September 2022. The YAML date/entry appears to be a DefiLlama indexing error. The actual event: a bridge upgrade script incorrectly left _totalOperatorWeight=0, collapsing the vote-threshold check — an MEV bot/whitehat withdrew 4K ETH + 2M USDC. Funds were returned; $500K bounty paid. Root cause: upgrade deployment code bug (proxy init misconfiguration). OUT OF SCOPE — code/config bug, not a structural taxonomy risk. Sources: https://www.bleepingcomputer.com/news/security/ronin-network-hacked-12-million-returned-by-white-hat-hackers/ https://threesigma.xyz/blog/exploit/ronin-network-12m-exploit-analysis', risk_ids: '[]', source_path: 'incidents/auto_2022-09-08_ronin.yaml', source_urls: '["https://twitter.com/Ronin_Network/status/1567907437219565568"]', title: 'Ronin', uid: 'incident:2022-09-08_ronin'};

