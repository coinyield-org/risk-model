MERGE (n:ProtocolType:RiskModelNode {uid: 'type:bridge'})
SET n += {attack_patterns: ['withdrawal_queue_blocking_lst'], description: 'Moves assets between chains by locking on source and minting on destination.', examples: ['wormhole', 'across', 'stargate', 'synapse', 'hop', 'cbridge', 'polygon_pos_bridge'], key_invariants: ['locked_on_source == minted_on_destination  (backing integrity)', 'total_bridged_supply <= lock_contract_balance', 'msg_nonce unique per chain pair'], key_parameters: ['signing_committee_size', 'signing_threshold', 'fraud_proof_window', 'liquidity_pool_size', 'fee_structure', 'rate_limits'], name: 'Cross-Chain Bridge', source_path: 'types/bridge.md', type_id: 'bridge', uid: 'type:bridge'};

MERGE (n:ProtocolType:RiskModelNode {uid: 'type:cdp'})
SET n += {attack_patterns: ['deleveraging_telegraph_frontrun', 'flash_governance', 'forced_selling_cascade_collateral'], description: 'Protocol mints its own stablecoin against user-posted collateral.', examples: ['makerdao', 'liquity', 'crvusd', 'gho', 'prisma', 'raft'], key_invariants: ['collateral_value * collateral_ratio >= minted_debt', 'total_minted <= debt_ceiling', 'stablecoin_price ≈ $1 (via PSM or redemption arb)', 'global_collateral_ratio > min_ratio'], key_parameters: ['collateralization_ratio', 'stability_fee', 'liquidation_ratio', 'debt_ceiling', 'savings_rate', 'peg_stability_module_params', 'liquidation_penalty'], name: 'CDP (Collateralized Debt Position)', source_path: 'types/cdp.md', type_id: 'cdp', uid: 'type:cdp'};

MERGE (n:ProtocolType:RiskModelNode {uid: 'type:concentrated_liquidity'})
