SET r += {deployment: ['ethereum', 'base'], note: 'The OptimismPortal has a guardian role (Coinbase-controlled) that can pause deposits and withdrawals; a paused bridge traps funds on L2 until governance unpauses — users have no recourse during the pause window', risk_id: 'bridge_pause_censorship', source_path: 'protocols/coinbase_bridge.md', uid: 'deployment:coinbase_bridge.base:active_risk:bridge_pause_censorship'};

MATCH (a:RiskModelNode {uid: 'deployment:coinbase_bridge.base'}), (b:RiskModelNode {uid: 'risk:per_deployment_profile_divergence'})
