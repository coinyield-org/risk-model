MERGE (n:Incident:RiskModelNode {uid: 'incident:2022-06-05_wintermute'})
SET n += {affected_assets: [], affected_protocols: [], amount_lost_usd: 27600000, chains: [], confidence: 'medium', date: '2022-06-05', event_type: 'exploit', incident_id: 'incident:2022-06-05_wintermute', near_miss: false, notes: 'Wintermute June 2022: Wintermute accidentally transferred 20M OP tokens to a counterfactual Gnosis Safe address that had not been deployed on Optimism (the deployer address matched on Ethereum but not L2). A third party exploited this by deploying the Safe with altered parameters and claiming the tokens (~$27.6M in OP). Evidences deployer_key_leak: operational address/key management failure resulted in loss of custody.', risk_ids: '["deployer_key_leak"]', source_path: 'incidents/auto_2022-06-05_wintermute.yaml', source_urls: '["https://banteg.mirror.xyz/iZAsBNL3j_5NIAY2Erav1r7Q4ecc7SC76AfMjyScs34"]', title: 'Wintermute', uid: 'incident:2022-06-05_wintermute'};

